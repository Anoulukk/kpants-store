VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── QR payment (PhaJay / BCEL One) ───────────────────────────
# Shows the "pay with BCEL One" button. Leave unset to stay WhatsApp-only.
VITE_QR_PAYMENT=

# Server only: set these in Vercel > Settings > Environment Variables.
# Never give them a VITE_ prefix and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
PHAJAY_SECRET_KEY=
# Optional: the key PhaJay signs webhooks with before KYC approval
PHAJAY_DEV_SECRET_KEY=
# Optional: true = PhaJay test endpoints (pay with the PhaJay sandbox app)
PHAJAY_SANDBOX=
